# react-app コンテナ(開発用の Vite サーバー)の設定。コピーして使います(react-app/config/*.env は .gitignore 対象):
#   cp react-app/config/react-app.env.example react-app/config/react-app.env
# まとめてコピーするなら ./scripts/setup-env.sh
#
# 本番の web(nginx)コンテナには、設定する値はありません。

TZ=Asia/Tokyo

# 開発サーバーが API / WebSocket を中継する先(Docker ネットワーク内の go-server)
VITE_API_TARGET=http://go-server:1323
