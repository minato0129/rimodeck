FROM node:22-bookworm-slim AS develop

WORKDIR /app

# 依存関係を先に入れる(ソースは実行時にボリュームで上書きされる)
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev"]

# --- 本番用 ---
# ビルドして、できた静的ファイルを nginx で配信する(設定は nginx.conf)
FROM develop AS build
RUN npm run build

FROM nginx:1.27-alpine AS production
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
