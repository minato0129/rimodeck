# ---------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------
# PostgreSQLのコンテナで使用する認証情報
POSTGRES_USER=rimodeck
POSTGRES_PASSWORD=rimodeck # パスワード
POSTGRES_DB=rimodeckdb
POSTGRES_PORT=5432 # 内部コンテナポート（Goからアクセスする際に必要）

# ---------------------------------------------------------------------
# Backend Configuration (Go Server)
# ---------------------------------------------------------------------
# Goアプリケーションの実行環境
GO_ENV=development
# GoアプリケーションからDBに接続するための設定
DB_HOST=postgres-db # Docker Composeのサービス名
DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-db:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
TZ=Asia/Tokyo
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}
DB_PORT=${POSTGRES_PORT}
# Goサーバーの公開ポート
GO_URL=0.0.0.0:5050

# ---------------------------------------------------------------------
# Frontend Configuration (React App)
# ---------------------------------------------------------------------
# React開発サーバーのポート
REACT_APP_PORT=3000
# ReactからGo APIにアクセスするためのURL（ブラウザ側で利用）

# ---------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------
TZ=Asia/Tokyo

# 秘密鍵
SECRET_KEY=f4041324-5f57-0e44-81af-b6c2cd7ec34c


