# postgres-db コンテナの設定。コピーして使います(env/*.env は .gitignore 対象):
#   cp env/postgres.env.example env/postgres.env
# まとめてコピーするなら ./scripts/setup-env.sh
#
# 値は展開や行末コメントを使わず、そのまま書いています(docker compose の env_file と source で同じ結果になります)。
# ここで決めたユーザー名・パスワード・DB名は、env/go-server.env の DB_URL と同じにしてください。
#
# 注意: この値が反映されるのは、データベースを最初に作るときだけです。
# すでに database/db-data がある場合、あとから変えても効きません(変えるときはデータを消して作り直します)。

POSTGRES_USER=rimodeck
# 開発用の固定値です。LAN の外に公開するときは、必ず推測されにくい値に変えてください。
POSTGRES_PASSWORD=rimodeck
POSTGRES_DB=rimodeckdb
TZ=Asia/Tokyo
