# go-server コンテナの設定。コピーして使います(env/*.env は .gitignore 対象):
#   cp env/go-server.env.example env/go-server.env
# まとめてコピーして SECRET_KEY も作るなら ./scripts/setup-env.sh
#
# 値は展開や行末コメントを使わず、そのまま書いています(docker compose の env_file と source で同じ結果になります)。

GO_ENV=development
TZ=Asia/Tokyo

# DB の接続文字列。ユーザー名・パスワード・DB名は、env/postgres.env と同じにしてください。
# ホスト名 postgres-db は Docker Compose のサービス名です。
# ホストで go run する場合は localhost に変えてください(README 参照)。
DB_URL=postgres://rimodeck:rimodeck@postgres-db:5432/rimodeckdb?sslmode=disable

# ログインのアクセストークン(JWT)に署名する秘密の鍵。**必ず自分で作った値を入れてください**(空・32文字未満だとサーバーは起動しません)。
# 作り方: openssl rand -hex 32   (出力をそのまま右に貼る。人に見せない・Git に入れない・チャットに貼らない)
# ./scripts/setup-env.sh を使うと、空のときに自動で作って書き込みます。
SECRET_KEY=

# 現在のエントリポイント(web_main)では使われません。待ち受けは 0.0.0.0:1323 固定です。
GO_URL=0.0.0.0:1323
