# config/app.env にコピーして使います(config/ は .gitignore 対象)
#   mkdir -p config && cp app.env.example config/app.env
#
# 値は展開やコメントを使わず、そのまま書いています。
# docker compose の env_file でも、シェルの source でも同じ結果になります。

# --- PostgreSQL ---
POSTGRES_USER=rimodeck
POSTGRES_PASSWORD=rimodeck
POSTGRES_DB=rimodeckdb
POSTGRES_PORT=5432

# --- Go サーバー ---
GO_ENV=development
TZ=Asia/Tokyo

# DB_URL のホスト名 postgres-db は Docker Compose のサービス名です。
# ホストで go run する場合は localhost に変えてください。
DB_URL=postgres://rimodeck:rimodeck@postgres-db:5432/rimodeckdb?sslmode=disable

# 現在のエントリポイント(web_main)では使われません。待ち受けは 0.0.0.0:1323 固定です。
GO_URL=0.0.0.0:1323
