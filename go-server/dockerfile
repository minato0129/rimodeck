FROM golang:1.25.3-bookworm AS develop

WORKDIR /app/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget curl git \
    && rm -rf /var/lib/apt/lists/*

# 依存モジュールを先に取得しておく(src は実行時にボリュームで上書きされる)
COPY src/go.mod src/go.sum ./
RUN go mod download

CMD ["sleep", "infinity"]
